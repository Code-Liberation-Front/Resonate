# Required: your Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Optional: sync slash commands instantly to a single server while developing.
# Without this, commands are synced globally and can take a while to appear.
# GUILD_ID=123456789012345678

# Optional: where to store the playlist database (default: resonate.db)
# DB_PATH=resonate.db

# Optional: seconds of inactivity before the bot leaves voice (default: 300)
# IDLE_TIMEOUT=300
